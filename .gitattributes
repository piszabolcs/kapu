# Every text file is stored and checked out with LF (spec FR-02: LF only, no CR).
* text=auto eol=lf
*.kapu text eol=lf
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.jsonl text eol=lf
*.png binary
*.safetensors binary
*.woff2 binary
*.ico binary
*.icns binary

# Test vectors are byte-exact fixtures (some contain CR or control bytes on purpose): never normalise.
tests/vectors/*.kapu binary
